<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nolabke.MainController"
            stylesheets="@../style.css">

    <top>
        <MenuBar>

            <menus>

                <Menu fx:id="fileMenu"
                        text="File">

                    <items>
                        <MenuItem fx:id="exportMenuItem"
                                  text="Export"
                                  onAction="#export"/>

                        <SeparatorMenuItem/>

                        <MenuItem fx:id="exitMenuItem"
                                  text="Exit"
                        onAction="#exitApp"/>
                    </items>

                </Menu>


                <Menu fx:id="settingsMenu"
                        text="Settings">
                    <items>
                        <Menu  fx:id="languageMenu"
                              text="Language">

                            <items>

                                <MenuItem fx:id="langPlItem"
                                          text="Polski"
                                          onAction="#setLanguagePl"/>
                                <SeparatorMenuItem/>
                                <MenuItem fx:id="langEnItem"
                                          text="English"
                                          onAction="#setLanguageEn"/>
                                <SeparatorMenuItem/>
                                <MenuItem fx:id="langDeItem"
                                          text="Deutsch"
                                          onAction="#setLanguageDe"/>

                            </items>

                        </Menu>

                        <SeparatorMenuItem/>

                        <MenuItem fx:id="fontSizeMenuItem"
                                  text="Font size"
                                  onAction="#openFontSettings"/>

                    </items>

                </Menu>


                <Menu fx:id="helpMenu"
                      text="Help">

                    <items>
                        <MenuItem fx:id="aboutMenuItem"
                                  text="About"
                                    onAction="#showAbout"/>


                        <MenuItem fx:id="checkUpdatesMenuItem"
                                  text="Updates"
                                  onAction="#checkForUpdates"/>
                    </items>

                </Menu>

            </menus>

        </MenuBar>
    </top>


    <center>
        <fx:include fx:id="budgetView" source="budget.fxml"/>
    </center>

</BorderPane>